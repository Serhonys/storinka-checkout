{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-storinka" class="btn btn-primary">{{ button_save }}</button>
        <a href="{{ cancel }}" class="btn btn-default">{{ button_cancel }}</a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
    {% if success %}<div class="alert alert-success">{{ success }}</div>{% endif %}
    <form action="{{ action }}" method="post" id="form-storinka" class="form-horizontal">
      <ul class="nav nav-tabs">
        <li class="active"><a href="#tab-general" data-toggle="tab">{{ tab_general }}</a></li>
        <li><a href="#tab-fields" data-toggle="tab">{{ tab_fields }}</a></li>
        <li><a href="#tab-rules" data-toggle="tab">{{ tab_rules }}</a></li>
        <li><a href="#tab-np" data-toggle="tab">{{ tab_np }}</a></li>
        <li><a href="#tab-look" data-toggle="tab">{{ tab_look }}</a></li>
      </ul>
      <div class="tab-content">
        <div class="tab-pane active" id="tab-general">
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_status }}</label>
            <div class="col-sm-9">
              <input type="hidden" name="module_storinka_status" value="0">
              <label class="checkbox-inline"><input type="checkbox" name="module_storinka_status" value="1" {% if module_storinka_status %}checked{% endif %}> {{ text_enabled }}</label>
            </div>
          </div>
          {% set toggles = [
            ['replace', entry_replace],
            ['guest', entry_guest],
            ['register', entry_register],
            ['login', entry_login],
            ['coupon', entry_coupon],
            ['comment', entry_comment],
            ['cart_edit', entry_cart_edit],
            ['image', entry_image],
            ['autoselect', entry_autoselect],
            ['standard_link', entry_standard],
            ['phone_mask', entry_phone_mask],
            ['auto_pay', entry_auto_pay],
            ['hide_columns', entry_hide_columns]
          ] %}
          {% for toggle in toggles %}
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ toggle[1] }}</label>
            <div class="col-sm-9">
              <input type="hidden" name="module_storinka_{{ toggle[0] }}" value="0">
              <input type="checkbox" name="module_storinka_{{ toggle[0] }}" value="1" {% if attribute(_context, 'module_storinka_' ~ toggle[0]) %}checked{% endif %}>
            </div>
          </div>
          {% endfor %}
        </div>
        <div class="tab-pane" id="tab-fields">
          <table class="table table-bordered">
            <thead><tr><th>{{ column_field }}</th><th>{{ column_status }}</th><th>{{ column_required }}</th><th>{{ column_width }}</th><th>{{ column_sort }}</th></tr></thead>
            <tbody>
              {% for key, field in fields %}
              <tr>
                <td>{{ field_labels[key] }}</td>
                <td><input type="hidden" name="module_storinka_field[{{ key }}][status]" value="0"><input type="checkbox" name="module_storinka_field[{{ key }}][status]" value="1" {% if field.status %}checked{% endif %}></td>
                <td><input type="hidden" name="module_storinka_field[{{ key }}][required]" value="0"><input type="checkbox" name="module_storinka_field[{{ key }}][required]" value="1" {% if field.required %}checked{% endif %}></td>
                <td>
                  <select name="module_storinka_field[{{ key }}][width]" class="form-control">
                    <option value="full" {% if field.width == 'full' %}selected{% endif %}>full</option>
                    <option value="half" {% if field.width == 'half' %}selected{% endif %}>half</option>
                  </select>
                </td>
                <td><input type="number" name="module_storinka_field[{{ key }}][sort]" value="{{ field.sort }}" class="form-control"></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
        <div class="tab-pane" id="tab-rules">
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_no_address }}</label>
            <div class="col-sm-9">
              <input type="text" name="module_storinka_no_address" value="{{ module_storinka_no_address }}" class="form-control">
              <p class="help-block">{{ help_no_address }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_rules }}</label>
            <div class="col-sm-9">
              <textarea name="module_storinka_rules" rows="8" class="form-control">{{ module_storinka_rules }}</textarea>
              <p class="help-block">{{ help_rules }}</p>
            </div>
          </div>
        </div>
        <div class="tab-pane" id="tab-np">
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_np_status }}</label>
            <div class="col-sm-9">
              <input type="hidden" name="module_storinka_np_status" value="0">
              <input type="checkbox" name="module_storinka_np_status" value="1" {% if module_storinka_np_status %}checked{% endif %}>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_np_key }}</label>
            <div class="col-sm-9">
              <input type="text" name="module_storinka_np_key" value="{{ module_storinka_np_key }}" class="form-control" autocomplete="off">
              <p class="help-block">{{ help_np }}</p>
            </div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_np_codes }}</label>
            <div class="col-sm-9"><input type="text" name="module_storinka_np_codes" value="{{ module_storinka_np_codes }}" class="form-control"></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_np_courier }}</label>
            <div class="col-sm-9"><input type="text" name="module_storinka_np_courier" value="{{ module_storinka_np_courier }}" class="form-control"></div>
          </div>
        </div>
        <div class="tab-pane" id="tab-look">
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_accent }}</label>
            <div class="col-sm-9"><input type="color" name="module_storinka_accent" value="{{ module_storinka_accent }}"></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_radius }}</label>
            <div class="col-sm-9"><input type="number" name="module_storinka_radius" value="{{ module_storinka_radius }}" class="form-control" style="max-width:120px"></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_heading }}</label>
            <div class="col-sm-9"><input type="text" name="module_storinka_heading" value="{{ module_storinka_heading }}" class="form-control"></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_button }}</label>
            <div class="col-sm-9"><input type="text" name="module_storinka_button_text" value="{{ module_storinka_button_text }}" class="form-control"></div>
          </div>
          <div class="form-group">
            <label class="col-sm-3 control-label">{{ entry_css }}</label>
            <div class="col-sm-9"><textarea name="module_storinka_css" rows="6" class="form-control">{{ module_storinka_css }}</textarea></div>
          </div>
        </div>
      </div>
    </form>
  </div>
</div>
{{ footer }}
